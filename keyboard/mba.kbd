(defcfg
  ;; Apple SPI Keyboard on the MacBook Air M1. Only this device is grabbed.
  ;; On another machine, replace this with that keyboard's …-event-kbd path.
  input  (device-file "/dev/input/by-path/platform-23510c000.spi-cs-0-event-kbd")
  output (uinput-sink "KMonad MacBook Air")
  fallthrough true
)

;; Caps Lock is Escape, so Vim leaves insert mode without leaving the home row.
(defsrc
  caps
  lsft k h j rsft
  a    s d f g
  z    x c v
  q    w e r
)

(defalias
  ;; Tap = k. Hold past 200ms = left Ctrl.
  kctrl (tap-hold 200 k lctl)

  ;; Tap = h. Hold past 200ms is Shift + Super.
  hhyper (tap-hold 200 h (around lsft (around lmet (layer-toggle hyper))))

  ;; Tap = j. Hold past 200ms moves the focused window.
  ;; With no focused window on this workspace, it switches instead.
  ;; H does nothing while J is held.
  jmove (tap-hold 200 j (layer-toggle move))

  mv1 (cmd-button "/usr/local/bin/gnome-ws move 1")
  mv2 (cmd-button "/usr/local/bin/gnome-ws move 2")
  mv3 (cmd-button "/usr/local/bin/gnome-ws move 3")
  mv4 (cmd-button "/usr/local/bin/gnome-ws move 4")
  mv5 (cmd-button "/usr/local/bin/gnome-ws move 5")
  mv6 (cmd-button "/usr/local/bin/gnome-ws move 6")
  mv7 (cmd-button "/usr/local/bin/gnome-ws move 7")
  mv8 (cmd-button "/usr/local/bin/gnome-ws move 8")
  mv9 (cmd-button "/usr/local/bin/gnome-ws move 9")
  mv10 (cmd-button "/usr/local/bin/gnome-ws move 10")
  mv11 (cmd-button "/usr/local/bin/gnome-ws move 11")
  mv12 (cmd-button "/usr/local/bin/gnome-ws move 12")
  mvlast (cmd-button "/usr/local/bin/gnome-ws move last")
)

(deflayer base
  esc
  lsft @kctrl @hhyper @jmove rsft
  a    s      d       f      g
  z    x      c       v
  q    w      e       r
)

(deflayer hyper
  _
  _ _ _ j _
  _ _ _ _ _
  _ _ _ _
  _ _ _ _
)

(deflayer move
  _
  _ _ XX _ _
  @mv1 @mv2 @mv3 @mv4 @mv5
  @mv6 @mv7 @mv8 @mv9
  @mv10 @mv11 @mv12 @mvlast
)
