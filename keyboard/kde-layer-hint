#!/usr/bin/env python3
# Pointer label for the KMonad H and J holds. KMonad runs as root, so show/hide
# find the Plasma session and return immediately. The daemon owns the window.
import os
import pwd
import subprocess
import sys

DEST = "org.dotfiles.LayerHint"
PATH = "/org/dotfiles/LayerHint"
IFACE = DEST


def kwin_session():
    try:
        listed = subprocess.check_output(["pgrep", "-x", "kwin_wayland"], text=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    for pid in listed.split():
        try:
            with open(f"/proc/{pid}/status", encoding="ascii", errors="replace") as status:
                uid_line = next(line for line in status if line.startswith("Uid:"))
        except (OSError, StopIteration):
            continue
        uid = int(uid_line.split()[1])
        try:
            user = pwd.getpwuid(uid).pw_name
        except KeyError:
            continue
        if user in ("", "root", "gdm"):
            continue
        bus = f"/run/user/{uid}/bus"
        if not os.path.exists(bus):
            continue
        return pid, uid, user, bus
    return None


def call_session(method, text=None):
    found = kwin_session()
    if found is None:
        return
    _pid, uid, user, bus = found
    gdbus = [
        "gdbus", "call", "--session",
        "--dest", DEST,
        "--object-path", PATH,
        "--method", f"{IFACE}.{method}",
    ]
    if text is not None:
        gdbus.append(text)
    env = {
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}",
        "XDG_RUNTIME_DIR": f"/run/user/{uid}",
        "PATH": os.environ.get("PATH", "/usr/bin"),
    }
    # KMonad is root. runuser is rejected for a normal user on this system.
    if os.geteuid() == 0:
        cmd = ["runuser", "-u", user, "--", "env", *[f"{k}={v}" for k, v in env.items()], *gdbus]
        popen_env = None
    else:
        cmd = gdbus
        popen_env = {**os.environ, **env}
    subprocess.Popen(
        cmd,
        env=popen_env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def ensure_display():
    if os.environ.get("DISPLAY"):
        return
    found = kwin_session()
    if found is None:
        return
    pid = found[0]
    try:
        with open(f"/proc/{pid}/environ", "rb") as env:
            items = env.read().split(b"\0")
    except OSError:
        return
    for item in items:
        if item.startswith(b"DISPLAY="):
            os.environ["DISPLAY"] = item.split(b"=", 1)[1].decode()
            return


def run_daemon():
    os.environ["QT_QPA_PLATFORM"] = "xcb"
    ensure_display()
    os.environ["QT_SCALE_FACTOR"] = "1"
    os.environ["QT_ENABLE_HIGHDPI_SCALING"] = "0"
    from PySide6.QtCore import QObject, Qt, Slot, ClassInfo
    from PySide6.QtDBus import QDBusAbstractAdaptor, QDBusConnection
    from PySide6.QtGui import QFont
    from PySide6.QtWidgets import QApplication, QLabel

    @ClassInfo(**{"D-Bus Interface": IFACE})
    class HintAdaptor(QDBusAbstractAdaptor):
        def __init__(self, parent):
            super().__init__(parent)

        @Slot(str)
        def Show(self, text):
            self.parent().show_text(text)

        @Slot()
        def Hide(self):
            self.parent().hide_text()

        @Slot(int, int)
        def Move(self, x, y):
            self.parent().move_to(x, y)

        @Slot(result=bool)
        def Visible(self):
            return self.parent().shown()

    class HintWindow(QLabel):
        def __init__(self):
            super().__init__()
            self.setWindowFlags(
                Qt.WindowType.Tool
                | Qt.WindowType.FramelessWindowHint
                | Qt.WindowType.WindowStaysOnTopHint
                | Qt.WindowType.WindowTransparentForInput
                | Qt.WindowType.WindowDoesNotAcceptFocus
                | Qt.WindowType.X11BypassWindowManagerHint
            )
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
            self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)
            self.setWindowTitle("kde-layer-hint")
            font = QFont()
            font.setBold(True)
            self.setFont(font)
            self.setStyleSheet(
                "QLabel {"
                " background-color: rgba(20, 20, 20, 0.88);"
                " color: white;"
                " padding: 4px 8px;"
                " border-radius: 6px;"
                "}"
            )
            self.setAttribute(Qt.WidgetAttribute.WA_X11DoNotAcceptFocus, True)
            self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            self._x = 0
            self._y = 0
            self._shown = 0
            self.hide()

        def show_text(self, text):
            # Two keyboards can press the same key. Stay up until both release.
            self._shown += 1
            self.setText(text)
            self.adjustSize()
            self.move(self._x, self._y)
            self.show()

        def hide_text(self):
            self._shown = max(0, self._shown - 1)
            if self._shown == 0:
                self.hide()

        def move_to(self, x, y):
            self._x = x
            self._y = y
            if self.isVisible():
                self.move(x, y)

        def shown(self):
            return self._shown > 0

    app = QApplication(sys.argv)
    window = HintWindow()
    owner = QObject()
    owner.show_text = window.show_text
    owner.hide_text = window.hide_text
    owner.move_to = window.move_to
    owner.shown = window.shown
    HintAdaptor(owner)
    bus = QDBusConnection.sessionBus()
    if not bus.registerObject(PATH, owner, QDBusConnection.RegisterOption.ExportAdaptors):
        print("kde-layer-hint: could not register the object", file=sys.stderr)
        sys.exit(1)
    if not bus.registerService(DEST):
        # Already running. A second copy would fight over the same label.
        sys.exit(0)
    sys.exit(app.exec())


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "daemon":
        run_daemon()
    elif action == "show" and len(sys.argv) == 3:
        call_session("Show", sys.argv[2])
    elif action == "hide" and len(sys.argv) == 2:
        call_session("Hide")
    else:
        print("usage: kde-layer-hint show <text> | hide | daemon", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
