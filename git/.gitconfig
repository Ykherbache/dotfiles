[user]
	name = Kherbache Yacine
	email = 38230283+Ykherbache@users.noreply.github.com

[core]
	pager = delta
	autocrlf = input

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictstyle = zdiff3

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://origin.cursor.com/git"]
	helper = 
	helper = !/home/yacinekherbache/.local/bin/origin credential-helper
[credential "https://origin.cursor.com"]
	helper = 
	helper = !/home/yacinekherbache/.local/bin/origin credential-helper
